MARKET_TRADER_ENVIRONMENT=local
MARKET_TRADER_TRADING_MODE=paper
MARKET_TRADER_APP_VERSION=0.1.0
MARKET_TRADER_DATABASE_URL=sqlite:////data/market_trader.db
MARKET_TRADER_DISPLAY_TIMEZONE=America/Chicago
MARKET_TRADER_AUTH_USERNAME=operator
# PBKDF2 hashes contain dollar signs; keep this value single-quoted for Docker Compose.
MARKET_TRADER_AUTH_PASSWORD_HASH='<pbkdf2_sha256_hash>'
MARKET_TRADER_SESSION_SECRET=<random_session_secret>
MARKET_TRADER_SESSION_TTL_SECONDS=3600
