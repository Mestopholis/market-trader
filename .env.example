MARKET_TRADER_ENVIRONMENT=local
MARKET_TRADER_TRADING_MODE=paper
MARKET_TRADER_APP_VERSION=0.1.0
MARKET_TRADER_DATABASE_URL=sqlite:////data/market_trader.db
MARKET_TRADER_DISPLAY_TIMEZONE=America/Chicago
MARKET_TRADER_AUTH_USERNAME=operator
MARKET_TRADER_AUTH_PASSWORD_HASH=<pbkdf2_sha256_hash>
MARKET_TRADER_SESSION_SECRET=<random_session_secret>
MARKET_TRADER_SESSION_TTL_SECONDS=3600
MARKET_TRADER_SCHWAB_MARKET_DATA_ENABLED=false
MARKET_TRADER_SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
MARKET_TRADER_SCHWAB_CLIENT_ID=<schwab_market_data_client_id>
MARKET_TRADER_SCHWAB_CLIENT_SECRET=<schwab_market_data_client_secret>
MARKET_TRADER_SCHWAB_ACCOUNTS_TRADING_ENABLED=false
MARKET_TRADER_SCHWAB_ACCOUNTS_TRADING_CLIENT_ID=<schwab_accounts_trading_client_id>
MARKET_TRADER_SCHWAB_ACCOUNTS_TRADING_CLIENT_SECRET=<schwab_accounts_trading_client_secret>
MARKET_TRADER_SCHWAB_TOKEN_ENCRYPTION_KEY=<random_token_encryption_key>
